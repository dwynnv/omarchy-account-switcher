[Desktop Entry]
X-AccountSwitcher=managed
Type=Application
Name=Personal Terminal
Comment=Terminal with the Personal accounts and folders (account-switcher)
Exec=@HOME@/.local/bin/account-switcher terminal --mode=personal
Icon=com.mitchellh.ghostty
StartupWMClass=org.omarchy.term-personal
Terminal=false
Categories=System;
NotShowIn=Hyprland;
