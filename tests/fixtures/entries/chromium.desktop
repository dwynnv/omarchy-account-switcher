[Desktop Entry]
X-AccountSwitcher=managed
Name=Chromium
Type=Application
Exec=@HOME@/.local/bin/account-switcher browser --mode=personal %U
StartupWMClass=chromium
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=@HOME@/.local/bin/account-switcher browser --mode=personal --new-window

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=@HOME@/.local/bin/account-switcher browser --mode=personal --private
